{
  "schema_version": 1,
  "ffmpeg_major": 9,
  "dependencies": [
    {
      "name": "ffmpeg",
      "version": "9.0.2",
      "url": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
      "sha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e",
      "license": "LGPL-2.1-or-later",
      "license_files": [
        "COPYING.LGPLv2.1"
      ],
      "configure": [
        "--disable-gpl",
        "--disable-nonfree",
        "--disable-autodetect",
        "--disable-network",
        "--enable-shared",
        "--disable-static",
        "--enable-libsvtav1",
        "--disable-doc",
        "--disable-debug",
        "--disable-x86asm",
        "--enable-libdav1d",
        "--enable-libopus"
      ],
      "platform_configure": {
        "darwin": [
          "--enable-videotoolbox",
          "--enable-audiotoolbox"
        ]
      }
    },
    {
      "name": "svt-av1",
      "version": "4.2.0",
      "url": "https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v4.2.0/SVT-AV1-v4.2.0.tar.bz2",
      "sha256": "512f2ea5649e3e76c2dddcc25c2556fb67a9582baaab207c9c96161c94659dad",
      "license": "BSD-3-Clause-Clear AND BSD-2-Clause",
      "license_files": [
        "LICENSE.md",
        "LICENSE-BSD2.md",
        "PATENTS.md"
      ],
      "cmake": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_APPS=OFF",
        "-DCOMPILE_C_ONLY=ON",
        "-DBUILD_TESTING=OFF"
      ],
      "platform_cmake": {
        "linux": [
          "-DEXCLUDE_HASH=ON"
        ]
      }
    },
    {
      "name": "dav1d",
      "version": "1.5.4",
      "url": "https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz",
      "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5",
      "license": "BSD-2-Clause",
      "license_files": [
        "COPYING"
      ],
      "meson": [
        "--buildtype=release",
        "--default-library=shared",
        "-Denable_tools=false",
        "-Denable_tests=false",
        "-Denable_asm=false"
      ]
    },
    {
      "name": "opus",
      "version": "1.5.2",
      "url": "https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz",
      "sha256": "65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1",
      "license": "BSD-3-Clause",
      "license_files": [
        "COPYING"
      ],
      "configure": [
        "--disable-static",
        "--enable-shared",
        "--disable-doc",
        "--disable-extra-programs"
      ]
    }
  ],
  "hash_provenance": "Pinned upstream release archive hashes cross-checked against locally installed Homebrew source SBOM; downloads must match before extraction.",
  "distribution": "Shared FFmpeg, SVT-AV1, dav1d and opus libraries only; copy license texts, PATENTS, source URLs and this manifest. GPL/nonfree builds fail verification. System development builds are never distribution input."
}
